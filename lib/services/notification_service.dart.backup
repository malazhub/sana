import 'dart:io';

import 'package:flutter/foundation.dart';
import 'package:flutter_local_notifications/flutter_local_notifications.dart';
import 'package:http/http.dart' as http;
import 'package:path_provider/path_provider.dart';
import 'package:permission_handler/permission_handler.dart';
import 'package:timezone/data/latest.dart' as tz;
import 'package:timezone/timezone.dart' as tz;

import '../models/medication.dart';

class NotificationService {
static final FlutterLocalNotificationsPlugin _notifications =
FlutterLocalNotificationsPlugin();

static Future<void> init() async {
tz.initializeTimeZones();

```
// Notification permission is required on Android 13+ and iOS.
if (!kIsWeb && (Platform.isAndroid || Platform.isIOS)) {
  try {
    await Permission.notification.request();
  } catch (_) {
    // Permission failure should not prevent the application from starting.
  }
}

const AndroidInitializationSettings androidSettings =
    AndroidInitializationSettings('@mipmap/ic_launcher');

const DarwinInitializationSettings iosSettings =
    DarwinInitializationSettings(
  requestAlertPermission: true,
  requestBadgePermission: true,
  requestSoundPermission: true,
);

const InitializationSettings settings = InitializationSettings(
  android: androidSettings,
  iOS: iosSettings,
);

await _notifications.initialize(settings);
```

}

/// Creates a stable notification ID for one medication/time combination.
static int _idFor(String medicationId, String timeOfDay) {
return '$medicationId-$timeOfDay'.hashCode & 0x7fffffff;
}

/// Downloads and caches the medication image.
///
/// If the image cannot be downloaded, the notification is still scheduled
/// without an image.
static Future<String?> _cachePhoto(
String medicationId,
String? photoUrl,
) async {
if (photoUrl == null || photoUrl.trim().isEmpty) {
return null;
}

```
try {
  final directory = await getTemporaryDirectory();

  final file = File(
    '${directory.path}${Platform.pathSeparator}med_photo_$medicationId.jpg',
  );

  if (await file.exists()) {
    return file.path;
  }

  final response = await http.get(Uri.parse(photoUrl));

  if (response.statusCode == 200) {
    await file.writeAsBytes(response.bodyBytes);
    return file.path;
  }
} catch (_) {
  // Ignore image errors. The notification can still work without an image.
}

return null;
```

}

static Future<void> _scheduleOne({
required String medicationId,
required String medicationName,
required String dosage,
required int quantity,
required String timeOfDay,
required String repeatType,
DateTime? specificDate,
String? photoUrl,
}) async {
final timeParts = timeOfDay.split(':');

```
if (timeParts.length != 2) {
  return;
}

final hour = int.tryParse(timeParts[0].trim());
final minute = int.tryParse(timeParts[1].trim());

if (hour == null || minute == null) {
  return;
}

if (hour < 0 || hour > 23 || minute < 0 || minute > 59) {
  return;
}

final now = DateTime.now();

DateTime scheduledDate;

if (repeatType == 'specific_date') {
  if (specificDate == null) {
    return;
  }

  scheduledDate = DateTime(
    specificDate.year,
    specificDate.month,
    specificDate.day,
    hour,
    minute,
  );

  if (scheduledDate.isBefore(now)) {
    return;
  }
} else {
  scheduledDate = DateTime(
    now.year,
    now.month,
    now.day,
    hour,
    minute,
  );

  // If today's time already passed, schedule tomorrow.
  if (scheduledDate.isBefore(now)) {
    scheduledDate = scheduledDate.add(const Duration(days: 1));
  }
}

final notificationId = _idFor(
  medicationId,
  timeOfDay,
);

final cachedPhotoPath = await _cachePhoto(
  medicationId,
  photoUrl,
);

final AndroidNotificationDetails androidDetails =
    AndroidNotificationDetails(
  'medication_channel',
  'Medication Reminder',
  channelDescription: 'Reminders to take your medications',
  importance: Importance.high,
  priority: Priority.high,
  playSound: true,
  enableVibration: true,
  largeIcon: cachedPhotoPath != null
      ? FilePathAndroidBitmap(cachedPhotoPath)
      : null,
  styleInformation: cachedPhotoPath != null
      ? BigPictureStyleInformation(
          FilePathAndroidBitmap(cachedPhotoPath),
          largeIcon: FilePathAndroidBitmap(cachedPhotoPath),
          contentTitle: '💊 Time to take $medicationName',
          summaryText: '$dosage - $quantity pill(s)',
        )
      : null,
);

const DarwinNotificationDetails iosDetails =
    DarwinNotificationDetails(
  categoryIdentifier: 'medication_category',
  presentAlert: true,
  presentSound: true,
  presentBadge: true,
);

final NotificationDetails details = NotificationDetails(
  android: androidDetails,
  iOS: iosDetails,
);

await _notifications.zonedSchedule(
  notificationId,
  '💊 Time to take $medicationName',
  '$dosage - $quantity pill(s)',
  tz.TZDateTime.from(
    scheduledDate,
    tz.local,
  ),
  details,
  androidScheduleMode:
      AndroidScheduleMode.exactAllowWhileIdle,
  matchDateTimeComponents:
      repeatType == 'daily'
          ? DateTimeComponents.time
          : null,
  payload: medicationId,
);
```

}

/// Backwards-compatible single reminder scheduling.
static Future<void> scheduleMedicationReminder({
required String medicationId,
required String medicationName,
required String dosage,
required int quantity,
required String timeOfDay,
required String repeatType,
DateTime? specificDate,
}) {
return _scheduleOne(
medicationId: medicationId,
medicationName: medicationName,
dosage: dosage,
quantity: quantity,
timeOfDay: timeOfDay,
repeatType: repeatType,
specificDate: specificDate,
);
}

/// Schedules all reminder times belonging to one medication.
static Future<void> scheduleForMedication(
Medication med,
) async {
if (med.id == null) {
return;
}

```
for (final time in med.reminderTimes) {
  await _scheduleOne(
    medicationId: med.id!,
    medicationName: med.name,
    dosage: med.dosage,
    quantity: med.quantity,
    timeOfDay: time,
    repeatType: med.repeatType,
    specificDate: med.specificDate,
    photoUrl: med.photoUrl,
  );
}
```

}

/// Cancels every reminder belonging to one medication.
static Future<void> cancelForMedication(
Medication med,
) async {
if (med.id == null) {
return;
}

```
for (final time in med.reminderTimes) {
  await _notifications.cancel(
    _idFor(med.id!, time),
  );
}
```

}

/// Legacy single-slot cancellation.
static Future<void> cancelAlarm(
String medicationId,
) async {
await _notifications.cancel(
medicationId.hashCode,
);
}

/// Cancels all notifications.
static Future<void> cancelAllAlarms() async {
await _notifications.cancelAll();
}
}
